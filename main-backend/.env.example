# 本地 llama-server 配置示例
# 复制本文件为 .env 后按需修改；.env 已被 .gitignore 排除，不会进入版本控制。

# llama-server 可执行文件路径；留空则默认调用 PATH 中的 llama-server（Windows 为 llama-server.exe）
# LLAMA_SERVER_BIN=C:\tools\llama.cpp\llama-server.exe

# 本地 gguf 模型路径；相对路径会基于后端工作目录解析
LLAMA_MODEL_PATH=models/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf

# vision projector 路径（多模态模型需要；Qwen2.5-VL 的 mmproj 可在 Hugging Face 下载对应 gguf）
# LLAMA_MMPROJ_PATH=models/mmproj-Qwen2.5-VL-7B-Instruct-Q8_0.gguf

# offload 到 GPU 的层数。
# 实测甜点位（RTX 2060 6GB / WDDM）：n_gpu_layers=18。
# 再高会挤到 WDDM 共享显存导致溢出，识图从 3.4s 暴涨到 100s+。
# 显存充足的卡可以设 999（全部 GPU），纯 CPU 则设 0。
LLAMA_N_GPU_LAYERS=18

# llama-server 监听端口；默认 8081，避免与后端 8080 冲突
LLAMA_SERVER_PORT=8081

# 上下文长度。
# 实测甜点位（RTX 2060 6GB / WDDM）：ctx=2048。
# 调大会重新触发共享显存溢出，建议根据显存测试后锁定。
LLAMA_CONTEXT_SIZE=2048
