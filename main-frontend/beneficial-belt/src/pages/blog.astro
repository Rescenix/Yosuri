---
import NavBar from '../components/NavBar.astro';
import PostList from '../components/blog/PostList.vue';
import AuthGuard from '../components/AuthGuard.astro';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <AuthGuard />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <title>研习录</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { height: auto; min-height: 100%; overflow-x: hidden; background: #ffffff; }
      body { font-family: 'Inter', system-ui, sans-serif; }
      .blog-container { max-width: 900px; margin: 0 auto; padding: 0 1.5rem 4rem; }
      @media (max-width: 640px) { .blog-container { padding: 0 1rem 3rem; } }
    </style>
  </head>
  <body style="padding-top: 100px !important;">
    <NavBar />
    <div class="blog-container">
      <PostList client:only="vue" />
    </div>
  </body>
</html>