---
import NavBar from '../components/NavBar.astro';
import HutCards from '../components/hut/HutCards.vue';
import AuthGuard from '../components/AuthGuard.astro';
---

<html>
  <head>
<AuthGuard /> 
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>杉汐的小屋 | 应用场景</title>
    <style>
      @import "/src/styles/global.css";
    </style>
  </head>
  <body>
    <NavBar />
    <main class="hut-container">
 
      <HutCards client:only="vue" />
    </main>
  </body>
</html>

<style>
  body {
  padding-top: 70px; /* 导航栏实际高度，后期可按需微调 */
}
  .hut-container {

      min-height: 100vh;  /* 保证内容够长时可以滚动 */
  overflow: visible;  /* 确保不隐藏溢出内容 */
    max-width: 800px;
    margin: 40px auto;
    padding: 0 20px;
  }
  .hut-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .hut-header h1 {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary, #0f172a);
    margin-bottom: 8px;
  }
  .hut-header p {
    font-size: 0.95rem;
    color: var(--text-secondary, #64748b);
  }
</style>