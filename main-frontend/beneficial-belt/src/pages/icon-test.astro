---
import TestIcon from '../components/TestIcon.vue'
---

<html>
  <head>
    <meta charset="UTF-8" />
    <title>Element Plus 图标测试</title>
    <!-- 导入映射，让浏览器识别裸模块说明符 -->
    <script type="importmap">
      {
        "imports": {
          "vue": "/node_modules/vue/dist/vue.esm-browser.js",
          "element-plus": "/node_modules/element-plus/dist/index.esm.js",
          "@element-plus/icons-vue": "/node_modules/@element-plus/icons-vue/dist/index.es.js"
        }
      }
    </script>
  </head>
  <body style="padding: 40px; background: #fff;">
    <h2>Element Plus 图标测试</h2>
    <div id="test-root"></div>
    <script type="module">
      import { createApp, h } from 'vue'
      import { ElIcon } from 'element-plus'
      import { Close, FullScreen, Promotion } from '@element-plus/icons-vue'

      const App = {
        render() {
          return h('div', { style: 'display: flex; gap: 16px;' }, [
            h(ElIcon, { size: 24, color: '#333' }, () => h(Close)),
            h(ElIcon, { size: 24, color: '#333' }, () => h(FullScreen)),
            h(ElIcon, { size: 24, color: '#2563eb' }, () => h(Promotion))
          ])
        }
      }

      createApp(App).mount('#test-root')
    </script>
  </body>
</html>