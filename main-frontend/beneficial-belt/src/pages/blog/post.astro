---
import NavBar from '../../components/NavBar.astro';

import BlogPost from '../../components/blog/BlogPost.vue';
import AuthGuard from '../../components/AuthGuard.astro';
---

<html>
  <head>
    <AuthGuard /> 
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>文章 | 杉汐的日记本</title>
    <style>
      @import "/src/styles/global.css";

      /* 文章页专属布局 */
      .article-page {
        max-width: 800px;
        margin: 100px auto 60px;  /* 顶部留空避开导航栏 */
        padding: 0 24px;
      }

      /* 文章容器：白底无装饰 */
      .article-page article {
        padding: 0;
        background: transparent;
      }

      /* 标题：蓝色渐变，清晰醒目 */
      .article-page h1 {
        font-size: 2.2rem;
        font-weight: 700;
        background: linear-gradient(135deg, #2563eb, #60a5fa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.75rem;
        line-height: 1.3;
      }

      /* 日期与元信息 */
      .article-page time,
      .article-page .post-date {
        display: block;
        font-size: 0.95rem;
        color: #64748b;
        margin-bottom: 2.5rem;
        border-left: 3px solid #2563eb;
        padding-left: 0.75rem;
      }

      /* 正文排版 */
      .article-page .post-content {
        font-size: 1.08rem;
        line-height: 1.85;
        color: #334155;
      }

      .article-page .post-content p {
        margin-bottom: 1.3rem;
      }

      /* 图片自适应 */
      .article-page .post-content img {
        max-width: 100%;
        border-radius: 8px;
        margin: 1.5rem 0;
      }

      /* 代码块 */
      .article-page .post-content pre {
        background: #f1f5f9;
        padding: 1.2rem;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 0.95rem;
        line-height: 1.6;
      }

      /* 未找到文章时 */
      .article-page .post-not-found {
        text-align: center;
        padding: 80px 0;
        color: #94a3b8;
      }

      .article-page .post-not-found a {
        color: #2563eb;
        text-decoration: none;
        font-weight: 500;
      }

      /* 移动端适配 */
      @media (max-width: 768px) {
        .article-page {
          margin-top: 80px;
          padding: 0 16px;
        }
        .article-page h1 {
          font-size: 1.8rem;
        }
        .article-page .post-content {
          font-size: 1rem;
          line-height: 1.7;
        }
      }
    </style>
  </head>
  <body>
    <NavBar />
  
    <div class="article-page">
      <BlogPost client:only="vue" />
    </div>
  </body>
</html>