---
import NavBar from "../components/NavBar.astro";
import ChatWidget from "../components/shanxi/ChatWidget.vue";
import ThemeProvider from "../components/ThemeProvider.vue";
import AuthGuard from "../components/AuthGuard.astro";
import RecentHutCard from '../components/RecentHutCard.vue';
---

<!doctype html>
<html lang="zh-CN">

  <head>

    <AuthGuard /> 
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>星尘核心</title>
    <style>
      /* 全局重置 */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html, body {
        height: 100%;
        overflow-x: hidden;
        background: #f8fafc;
        font-family: 'Inter', system-ui, sans-serif;
      }

      body {
        display: flex;
        flex-direction: column;
      }

      .navbar {
        flex-shrink: 0;
      }

      /* 主容器：全屏视觉 + 玻璃态卡片 */
      .hero-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: linear-gradient(135deg, #e6f0ff 0%, #ffffff 100%);
        min-height: calc(100vh - 60px); /* 减去导航栏高度 */
      }

      .glass-card {
        max-width: 500px;
        width: 100%;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        border-radius: 32px;
        padding: 2rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.5);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }

      .glass-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
      }

      /* 最近卡片内部样式（如果 RecentHutCard 已有样式，则不需要额外定义，但为了确保显示，加一些基础样式） */
      .recent-wrapper {
        width: 100%;
      }

      /* 响应式 */
      @media (max-width: 768px) {
        .hero-container {
          padding: 1rem;
        }
        .glass-card {
          padding: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <NavBar />

    <ThemeProvider client:only="vue">
      <div class="hero-container">
        <div class="glass-card">
          <div class="recent-wrapper">
            <RecentHutCard client:only="vue" />
          </div>
        </div>
      </div>
      <ChatWidget client:only="vue" sessionId="" />
    </ThemeProvider>
  </body>
</html>