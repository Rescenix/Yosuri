---
import NavBar from '../components/NavBar.astro';
import ChatWidget from '../components/shanxi/chat/ChatWidget.vue';
import AuthGuard from '../components/AuthGuard.astro';
---

<html lang="zh-CN">
  <head>
    <AuthGuard />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Aurora</title>
    
    <!-- ✅ 新增：直接内联的 Aurora 流星 Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath fill='%23c96442' d='M12 2L14.5 8.5L21 11L14.5 13.5L12 20L9.5 13.5L3 11L9.5 8.5L12 2Z' stroke='%23c96442' stroke-width='0.5' stroke-linejoin='round'/%3E%3C/svg%3E" />

    <!-- ✨ 基础布局设定 -->
    <style is:global>
      @import "/src/styles/global.css";

      html,
      body {
        height: 100%;
        margin: 0;
        /* 外部滚轴彻底消失的核心 */
        overflow: hidden; 
        background: #f4f3ee;
        color: #1b1a18;
      }

      body {
        display: flex;
        flex-direction: column;
        font-family: "Source Serif 4", "Iowan Old Style", Georgia, serif;
      }

      .app-shell {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
      }

      .chat-page {
        flex: 1;
        min-height: 0;
        padding: 0;
        background: #f4f3ee;
        position: relative;
      }

      .chat-page :global(.chat-window) {
        position: absolute;
        inset: 0;
        width: auto;
        height: auto;
        max-height: none;
        border-radius: 24px;
      }

      .chat-page :global(.chat-window.expanded) {
        inset: 0;
        border-radius: 0;
      }

      .chat-page :global(.chat-toggle-button) {
        display: none;
      }

      .chat-page :global(.chat-window .message.bot) {
        max-width: 100%;
      }

      .chat-page :global(.chat-window .message.user) {
        max-width: 85%;
      }

      .chat-page :global(.chat-window .chat-messages) {
        padding-bottom: 18px;
      }
    </style>
  </head>

  <body>
    <div class="app-shell">
      <main class="chat-page">
        <ChatWidget client:only="vue" sessionId="" autoOpen={true} />
      </main>
    </div>
  </body>
</html>