---
import NavBar from '../components/NavBar.astro';
import BookShelf from '../components/reading/BookShelf.vue';
import AuthGuard from '../components/AuthGuard.astro';
---

<html>
  <head>
<script is:inline>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js', { scope: '/' })
        .then(() => console.log('✅ SW registered'))
        .catch((err) => console.error('SW registration failed', err));
    });
  }
</script>
<script is:inline>
  // 手动缓存入口页面，使用与 sw.js 一致的缓存名
  if ('caches' in window) {
    caches.open('shanxi-reader-v5').then(cache => {
      cache.add('/reading-hut/').catch(() => {});
    });
  }
</script>
       <AuthGuard />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>阅读小屋 | 杉汐</title>
    <style>
      @import "/src/styles/global.css";
    </style>
  </head>
  <body>
    <NavBar />
    <main class="hut-container">
      <div class="hut-header">
        <h1>阅读小屋</h1>
        <p>杉汐陪你阅读</p>
      </div>
      <BookShelf client:only="vue" />
    </main>
  </body>
</html>

<script></script>
<style>
  .hut-container {
    max-width: 800px;
    margin: 100px auto 0;
    padding: 20px;
  }
  .hut-header {
    text-align: center;
    margin-bottom: 24px;
  }
</style>